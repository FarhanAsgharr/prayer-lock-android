<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-transfer rules (Android 12+, android:dataExtractionRules).

  The Android 12 replacement for backup_rules.xml, covering both cloud backup
  and device-to-device transfer. Same policy: keep prayer history and settings,
  never move the database encryption key or the disposable native mirrors.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="prayer_lock_schedule.xml" />
        <exclude domain="sharedpref" path="prayer_lock_silence.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="prayer_lock_schedule.xml" />
        <exclude domain="sharedpref" path="prayer_lock_silence.xml" />
    </device-transfer>
</data-extraction-rules>
